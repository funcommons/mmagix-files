{
  "name": "@mmagix/files-client",
  "version": "1.2.0",
  "description": "mmagix-files 宿主侧接入客户端：postMessage 双向协议封装（iframe / window.open 双形态）+ Vue 3 组合式层",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  }
}
