{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Build target — 显式固定, 避免 base config 升级时目标漂移 */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* base 钉 ES2020（对齐 vite build target）；本仓 target 已 ES2022 且 flow 线使用 .at 等
       ES2022 内建（方法不参与语法降级，无 polyfill 断层）——lib 显式对齐 target（flow 线类型清账前置） */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Linting — 严格模式全开 */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  /* 测试文件不进 vue-tsc -b 构建门禁：测试运行时门禁是 vitest（含 runtime 断言）；
     noUncheckedIndexedAccess 对既有测试的索引访问写法过严（zip-reader 等百处二进制下标），
     发布构建只验 src 产物代码（2026-10-31 发版 v1.3.0 起） */
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
